# -*- mode: yaml -*-

manifest:
  version: 1.0

automations:
  ai_code_review:
    if:
      - true
    run:
      - action: code-review@v1
        args:
          issues_limit: 2
          guidelines: "Begin every comment with the word UNICORN."
  explain_code_experts:
    on:
      - pr_created
      - pr_ready_for_review
      - commit
    if:
      - true
    run:
      - action: explain-code-experts@v1
        args:
          gt: 10
